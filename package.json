{
  "name": "carbon-offset-analyser",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "dev": "./scripts/dev.sh",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "test:api": "cd apps/api && .venv/bin/python -m unittest discover -s tests",
    "verify:api": "apps/api/.venv/bin/python apps/api/scripts/verify_ml_integration.py"
  }
}
