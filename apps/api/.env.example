# Backend environment (copy to .env). Everything is optional for local runs:
# without AWS credentials the API uses built-in Punjabi/Hindi/English advice.

CORS_ORIGINS=http://localhost:3000

# AWS (Bedrock advice). Use `aws configure` or set keys here.
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
ADVICE_MODE=bedrock

# Optional S3 bucket for caching field analyses
# CACHE_BUCKET=

# Rupees per US dollar used for carbon-credit income
INR_PER_USD=88
